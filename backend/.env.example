# Application Port and Environment
PORT=3000
NODE_ENV=development
FRONTEND_URL=http://localhost:3001

# Public Access Configuration (allows anonymous users to review public PRs)
PUBLIC_ACCESS_ENABLED=true

# MongoDB Database URI
MONGODB_URI=mongodb://localhost:27017/ai-pr-review

# Redis Configuration (BullMQ & Cache)
REDIS_URL=redis://localhost:6379
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=

# JWT Authentication Secrets
JWT_ACCESS_SECRET=replace-with-a-very-secure-jwt-access-secret-32-chars
JWT_REFRESH_SECRET=replace-with-a-very-secure-jwt-refresh-secret-32-chars
JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=7d

# Existing AI Platform Integration
AI_PLATFORM_URL=http://localhost:4000
AI_PLATFORM_PR_REVIEW_API_KEY=ai-platform-pr-review-api-key-placeholder
AI_PLATFORM_TIMEOUT_MS=60000
AI_MODEL=gemini-1.5-pro

# Existing Notification Service Integration
NOTIFICATION_SERVICE_URL=http://localhost:4001
NOTIFICATION_PR_REVIEW_API_KEY=notification-pr-review-api-key-placeholder
NOTIFICATION_TIMEOUT_MS=10000

# AI Model Regression Detection Platform Integration
MODEL_REGRESSION_URL=http://localhost:5000
MODEL_REGRESSION_API_KEY=model-regression-api-key-placeholder
MODEL_REGRESSION_TIMEOUT_MS=10000
REGRESSION_CHECK_MODE=manual
REGRESSION_BLOCKING=false

# GitHub App Integration
GITHUB_APP_ID=123456
GITHUB_APP_CLIENT_ID=Iv1.exampleclientid
GITHUB_APP_CLIENT_SECRET=exampleclientsecret
GITHUB_APP_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\nMIIEowIBAAKCAQEA...\n-----END RSA PRIVATE KEY-----"
GITHUB_WEBHOOK_SECRET=your_github_webhook_secret_here

# PR Review Limits & Settings
AUTO_COMMENT_ENABLED=false
REVIEW_MAX_FILES=50
REVIEW_MAX_DIFF_SIZE=1048576
REVIEW_MAX_TOKENS=32000

# API Rate Limiting (Throttler)
RATE_LIMIT_TTL=60
RATE_LIMIT_MAX=30
